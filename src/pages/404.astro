---
/**
 * The 404 page: sober, in the same frame, and pointing a lost visitor at
 * the two places they are most likely to want.
 */
import Page from "../layouts/Page.astro";
---

<Page
  title="Page not found"
  description="The address you followed does not exist on blog.ithings.ch."
  eyebrow="404"
  heading="Page not found"
>
  <p>
    There is nothing at this address. Try <a href="/">the home page</a> or the <a
      href="/writing"
    >writing index</a>; the <a href="/search">search</a> covers every entry.
  </p>
</Page>
