---
/**
 * Lab list (spec §7.7), on the visual pattern of /writing: mono date of the
 * last touch in the left column, serif title, the intent as the summary and
 * the status badge with the mono facts. Sorted by last activity.
 */
import LangBadge from "../../components/LangBadge.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import Base from "../../layouts/Base.astro";
import { isoDate } from "../../lib/format";
import { entryUrl } from "../../lib/ids";
import { visibleLab } from "../../lib/queries";

const entries = await visibleLab();
const noun = entries.length === 1 ? "entry" : "entries";
---

<Base
  title="Lab"
  description="Open-ended explorations by Thomas Pham: the questions worked through in the open, before or without a conclusion."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Notebook</p>
      <h1 class="display">Lab</h1>
      <div class="intro">
        <p>
          Explorations and unfinished questions about platforms, connected things and the AI woven
          through both. Each note states its intent when it opens and its outcome when it closes —
          including the abandonments.
        </p>
      </div>
    </div>
  </header>

  <div class="wrap">
    <section class="list" aria-labelledby="list-label">
      <div class="sec">
        <p id="list-label">{entries.length} {noun}</p>
      </div>
      {
        entries.length === 0 ? (
          <div class="empty">
            <p>No lab entry is open.</p>
          </div>
        ) : (
          <ol role="list" class="rows">
            {entries.map((e) => (
              <li class="row">
                <time class="date" datetime={isoDate(e.data.lastTouched)}>
                  {isoDate(e.data.lastTouched)}
                </time>
                <div class="body">
                  <h2 class="title serif" lang={e.data.lang}>
                    <a href={entryUrl("lab", e.id)}>{e.data.title}</a>
                  </h2>
                  <p class="summary" lang={e.data.lang}>
                    {e.data.intent}
                  </p>
                  <p class="facts">
                    <StatusBadge status={e.data.status} />
                    <span class="sep" aria-hidden="true">
                      ·
                    </span>
                    <LangBadge lang={e.data.lang} />
                    <span class="sep" aria-hidden="true">
                      ·
                    </span>
                    <span>started {isoDate(e.data.started)}</span>
                    {e.data.topics.length > 0 && (
                      <>
                        <span class="sep topics-sep" aria-hidden="true">
                          ·
                        </span>
                        <span class="topics">{e.data.topics.map((t) => t.label).join(", ")}</span>
                      </>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: var(--s-8) var(--s-6);
  }

  .eyebrow {
    margin-bottom: var(--s-4);
  }

  h1 {
    max-width: 18ch;
  }

  .intro {
    max-width: 38rem;
    margin-top: var(--s-5);
    font-size: var(--fs-lede);
    line-height: 1.55;
    color: var(--muted);
  }

  .sec {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: 1.4;
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--muted);
  }

  .rows {
    border-bottom: var(--hairline);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--s-2);
    padding-block: var(--s-5);
    border-top: var(--hairline);
  }

  .date,
  .facts {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: 1.5;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .title {
    font-size: var(--fs-title);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: -0.005em;
    margin-bottom: var(--s-2);
  }

  .title a {
    text-decoration: none;
  }

  /* The whole row is clickable; the title stays the only link. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row:hover .title a,
  .title a:focus-visible {
    color: var(--accent);
  }

  .title a:focus-visible {
    outline: none;
  }

  .row:has(.title a:focus-visible) {
    outline: 1.5px solid var(--accent);
    outline-offset: 2px;
  }

  .summary {
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: var(--s-3);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5em;
    row-gap: var(--s-1);
  }

  .sep {
    color: var(--line);
  }

  .topics {
    color: var(--muted);
  }

  /* Narrow screens: topics take their own line, no dangling separator. */
  @media (max-width: 39.99em) {
    .topics-sep {
      display: none;
    }

    .topics {
      flex-basis: 100%;
    }
  }

  .empty {
    display: block;
    padding-block: var(--s-6);
    border-block: var(--hairline);
    color: var(--muted);
  }

  @media (min-width: 40em) {
    .row {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      column-gap: var(--s-5);
    }

    /* Sit the date on the title's first baseline. */
    .date {
      padding-top: 0.4rem;
    }
  }
</style>
