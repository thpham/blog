---
/**
 * The <head> meta layer (spec §9, shared frame of spec §7.2): title,
 * description, canonical, favicon, OG/Twitter, hreflang alternates, the
 * JSON-LD block, the self-hosted fonts, and the `<title>` in the
 * `<page> · ithings` shape (the home page is `ithings — Thomas Pham`).
 * Demo pages arrive with `noindex`; hreflang is emitted only for the
 * translation pairs passed by the page.
 */
import { Font } from "astro:assets";
import { SITE } from "../lib/site";

type JsonLd = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  lang?: "en" | "fr";
  noindex?: boolean;
  /** Absolute URL or site-relative path. */
  ogImage?: string;
  jsonLd?: JsonLd | JsonLd[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description,
  lang = "en",
  noindex = false,
  ogImage,
  jsonLd,
  alternates = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const pathname = Astro.url.pathname
  .replace(/\.html$/, "")
  .replace(/(^|\/)index$/, "$1")
  .replace(/(.)\/+$/, "$1");
const canonical = new URL(pathname, site).href;
const fullTitle = title === SITE.name ? `${title} — ${SITE.author}` : `${title} · ${SITE.name}`;
const image = ogImage ? new URL(ogImage, site).href : undefined;
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, site).href} />)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:site" content={`@${SITE.socials.x}`} />

<Font cssVariable="--font-serif" preload={[{ style: "normal" }, { style: "italic" }]} />
<Font cssVariable="--font-sans" preload={[{ weight: 400 }]} />
<Font cssVariable="--font-mono" />

{ld && <script type="application/ld+json" set:html={ld} />}
