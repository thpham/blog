---
import { getCollection } from "astro:content";
import { isVisible, navItems, type VisibilityData } from "../lib/content";
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";

const prod = import.meta.env.PROD;
const [writing, lab, radar] = await Promise.all([
  getCollection("writing", (e) => isVisible(e.data, prod)),
  getCollection("lab", (e) => isVisible(e.data, prod)),
  // Radar notes carry no draft status today; the cast keeps them behind the
  // same visibility rule should one be added.
  getCollection("radar", (e) => isVisible(e.data as VisibilityData, prod)),
]);
const items = navItems({ writing: writing.length, lab: lab.length, radar: radar.length });

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "") || "/";
// /horizon and /topics/* are filters of the writing list.
const SUB_SECTIONS: Record<string, string[]> = { "/writing": ["/horizon", "/topics"] };
const within = (href: string) => path === href || path.startsWith(`${href}/`);
const isCurrent = (href: string) => within(href) || (SUB_SECTIONS[href] ?? []).some(within);
---

<header class="site-header" lang="en">
  <div class="wrap bar">
    <a class="home" href="/"><Wordmark /></a>
    <nav aria-label="Main">
      <ul role="list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <a class="search" href="/search" aria-label="Search">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="6.75" cy="6.75" r="4.75"></circle>
          <path d="M10.25 10.25 14 14"></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--hairline);
  }

  /*
   * One baseline for the whole bar: the wordmark is set in em of its own
   * font size (see Wordmark.astro), so its letters sit on the same line as
   * the navigation and the mono labels of the theme switch.
   */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--s-6);
    row-gap: var(--s-3);
    padding-block: var(--s-5) var(--s-4);
  }

  .home {
    /* The wordmark's "i" stem, not its arcs, sits on the grid line. */
    margin-left: -0.19em;
    margin-right: auto;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    order: 3;
    flex-basis: 100%;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-5);
    row-gap: var(--s-1);
  }

  nav a,
  .search {
    color: var(--muted);
    text-decoration: none;
  }

  nav a {
    font-size: var(--fs-ui);
    line-height: 1.5;
  }

  nav a:hover,
  .search:hover {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    color: var(--text);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.5em;
  }

  .tools {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .search {
    display: inline-flex;
    padding: 6px;
    margin: -6px 0;
    /* Centre the glass on the x-height of the navigation, like a letter. */
    transform: translateY(4px);
  }

  .search svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  @media (min-width: 40em) {
    .bar {
      flex-wrap: nowrap;
      padding-block: var(--s-5);
    }

    .home {
      font-size: 1.375rem;
    }

    nav {
      order: 0;
      flex-basis: auto;
    }

    .tools {
      gap: var(--s-4);
    }
  }
</style>
