---
/**
 * A slide deck. Speaker Deck (player URLs), Google Slides and slides.com
 * are embedded in a lazy 16:9 iframe; any other URL becomes a link card.
 * See slidesEmbed() in src/lib/artifacts.ts for the URL rules.
 */
import { displayUrl, slidesEmbed } from "../lib/artifacts";

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const embed = slidesEmbed(url);
---

{
  embed ? (
    <figure class="slides">
      <div class="frame">
        <iframe
          src={embed}
          title={title}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>
      <figcaption>
        <span class="label">Slides</span>
        <span class="title">{title}</span>
        <a href={url}>
          {displayUrl(url).split("/")[0]}
          <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  ) : (
    <a class="card" href={url}>
      <span class="label">Slides</span>
      <span class="name">{title}</span>
      <span class="host">
        {displayUrl(url)} <span aria-hidden="true">↗</span>
      </span>
    </a>
  )
}

<style>
  .slides,
  .card {
    margin-block: 2em;
  }

  .frame {
    aspect-ratio: 16 / 9;
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  figcaption a {
    margin-left: auto;
  }

  .label,
  figcaption a,
  .host {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .label {
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--accent);
  }

  .card {
    display: grid;
    row-gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    border: var(--hairline);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--muted);
  }

  .name {
    font-family: var(--font-serif);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    color: var(--text);
  }

  .card:hover .name {
    color: var(--accent);
  }

  .host {
    overflow-wrap: anywhere;
  }
</style>
