---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Meta from "../components/Meta.astro";
import "../styles/global.css";

type JsonLd = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  lang?: "en" | "fr";
  noindex?: boolean;
  /** Absolute URL or site-relative path. */
  ogImage?: string;
  jsonLd?: JsonLd | JsonLd[];
  alternates?: Array<{ hreflang: string; href: string }>;
  bodyAttrs?: Record<string, string | number | boolean | undefined>;
}

const { title, description, lang = "en", noindex = false, ogImage, jsonLd, alternates = [], bodyAttrs = {} } = Astro.props;

// Analytics (spec §9): the GoatCounter script ships only when the counter's
// code is set (GOATCOUNTER_CODE at build time) — unset, the site ships none.
const goatcounter = process.env.GOATCOUNTER_CODE;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Theme bootstrap (inline, first thing in <head>, before any stylesheet):
      localStorage.theme holds the preference (auto | light | dark), <html
      data-theme> gets the resolved theme and data-theme-pref the preference.
      Without JS, tokens.css falls back to prefers-color-scheme.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        var pref = "auto";
        function valid(v) {
          return v === "light" || v === "dark" ? v : "auto";
        }
        function apply() {
          root.dataset.theme = pref === "auto" ? (mq.matches ? "dark" : "light") : pref;
          root.dataset.themePref = pref;
        }
        try {
          pref = valid(localStorage.getItem("theme"));
        } catch (e) {}
        apply();
        mq.addEventListener("change", function () {
          if (pref === "auto") apply();
        });
        window.addEventListener("storage", function (e) {
          if (e.key === "theme") {
            pref = valid(e.newValue);
            apply();
          }
        });
        window.__ithingsTheme = {
          set: function (next) {
            pref = valid(next);
            try {
              localStorage.setItem("theme", pref);
            } catch (e) {}
            apply();
          },
        };
      })();
    </script>
    <Meta
      title={title}
      description={description}
      lang={lang}
      noindex={noindex}
      ogImage={ogImage}
      jsonLd={jsonLd}
      alternates={alternates}
    />
    {
      goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body {...bodyAttrs}>
    <a class="skip-link" href="#main" lang="en">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
