---
/**
 * A static page outside the collections (About, Colophon, 404): a page
 * head — mono eyebrow, display title — then the body at the article's
 * prose measure. MDX pages point their `layout` frontmatter at this file,
 * which hands them the frame and the prose styles.
 */
import Base from "./Base.astro";
import "../styles/prose.css";

interface Props {
  title?: string;
  description?: string;
  /** Visible h1; defaults to `title`. */
  heading?: string;
  eyebrow?: string;
  jsonLd?: Record<string, unknown>;
  /** From an MDX page's `layout` frontmatter: the page's frontmatter object. */
  frontmatter?: {
    title: string;
    description: string;
    heading?: string;
    eyebrow?: string;
    jsonLd?: Record<string, unknown>;
  };
}

// Both call shapes land here: a component page passes its values as props,
// an MDX page passes them under `frontmatter`.
const fm = Astro.props.frontmatter;
const title = Astro.props.title ?? fm?.title;
const description = Astro.props.description ?? fm?.description;
const heading = Astro.props.heading ?? fm?.heading ?? title;
const eyebrow = Astro.props.eyebrow ?? fm?.eyebrow;
const jsonLd = Astro.props.jsonLd ?? fm?.jsonLd;
---

<Base title={title as string} description={description as string} jsonLd={jsonLd}>
  <header class="page-head">
    <div class="wrap">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="display">{heading}</h1>
    </div>
  </header>
  <div class="wrap body">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .body {
    padding-block: var(--s-7) var(--s-9);
  }
</style>
