{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/excalidraw/export.mjs",
    "dev": "yarn predev && astro dev",
    "prebuild": "node tools/excalidraw/export.mjs",
    "build": "yarn prebuild && astro build && pagefind --site dist",
    "build:nodemo": "yarn prebuild && ITHINGS_NO_DEMO=1 astro build && pagefind --site dist-nodemo",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:build": "yarn build && yarn build:nodemo && vitest run tests/build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "astro-expressive-code": "^0.44.2",
    "mermaid-isomorphic": "3.1.0",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emnapi/runtime": "^1.11.3",
    "@excalidraw/utils": "0.1.5",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@pagefind/default-ui": "1.5.2",
    "@resvg/resvg-js": "2.6.2",
    "pagefind": "1.5.2",
    "satori": "0.57.2",
    "satteri": "^0.10.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "yarn@4.18.0"
}
